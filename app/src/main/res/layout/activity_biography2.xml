<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:paddingTop="50dp"
    tools:context=".biography2">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:textAlignment="center"
            android:text="@string/biography"
            android:textColor="@color/sand"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/backArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_marginLeft="20dp"
            android:contentDescription="@string/todo"
            android:src="@drawable/arrow" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/navigation"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="18dp"
        android:layout_marginTop="69dp"
        android:layout_marginEnd="17dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/scroll_img"
        android:contentDescription="@string/todo2" />


    <ImageView
        android:layout_width="125dp"
        android:layout_height="258dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/professor"
        android:contentDescription="@string/todo3" />



    <LinearLayout
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/navigation"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="15dp"
        android:layout_alignParentBottom="true">

        <ImageView
            android:id="@+id/navigation_notes"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/notes"
            android:contentDescription="@string/notesDescription" />

        <ImageView
            android:id="@+id/navigation_profile"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/profile"
            android:contentDescription="@string/profileDescription" />

        <ImageView
            android:id="@+id/navigation_main"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/main"
            android:contentDescription="@string/mainDescription" />

        <ImageView
            android:id="@+id/navigation_bio"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/scroll"
            android:contentDescription="@string/bioDescription" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:paddingLeft="90dp"
        android:layout_marginTop="99dp"
        android:layout_marginEnd="80dp"
        android:orientation="vertical">

        <ListView
            android:id="@+id/listview1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:dividerHeight="2dp"/>
    </LinearLayout>

</RelativeLayout>