<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".RoomFragment">


    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/room_frame"
            android:padding="24dp"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/challenge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Challanges"
                android:textSize="22sp"
                android:textAllCaps="true"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"
                android:textColor="@color/dark_gold"
                android:fontFamily="@font/poppins_medium" />

            <ImageView
                android:id="@+id/roomImage"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerInside"
                android:contentDescription="RoomImage"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/roomTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Title"
                android:textSize="22sp"
                android:layout_marginTop="30dp"
                android:textColor="@color/dark_gold"
                android:fontFamily="@font/poppins" />
            <Button
                android:id="@+id/openTool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPEN TOOL"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_semibold"
                android:textStyle="bold"
                android:textSize="25sp"
                android:backgroundTint="@color/main_blue"
                android:textColor="@android:color/black" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>