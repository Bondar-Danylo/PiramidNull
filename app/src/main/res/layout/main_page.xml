<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainPage"
    android:background="@color/dark_bg">

    <LinearLayout
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/navigation"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_margin="30dp"
        android:padding="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:weightSum="4">

        <!-- Notes Tab -->
        <LinearLayout
            android:id="@+id/tab_notes"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/navigation_notes"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/blocks"
                android:contentDescription="@string/notesDescription" />

            <TextView
                android:id="@+id/label_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes"
                android:textColor="@color/sand"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Repeat for other tabs -->

        <!-- Profile Tab -->
        <LinearLayout
            android:id="@+id/tab_profile"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/navigation_profile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/user_round"
                android:contentDescription="@string/notesDescription" />

            <TextView
                android:id="@+id/label_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/sand"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Main Tab -->
        <LinearLayout
            android:id="@+id/tab_main"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/navigation_main"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/gallery_horizontal"
                android:contentDescription="@string/mainDescription" />

            <TextView
                android:id="@+id/label_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rooms"
                android:textColor="@color/sand"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Bio Tab -->
        <LinearLayout
            android:id="@+id/tab_bio"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/navigation_bio"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/scroll_text"
                android:contentDescription="@string/bioDescription" />

            <TextView
                android:id="@+id/label_bio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bio"
                android:textColor="@color/sand"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
