<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createAccountOverlay"
    android:layout_width="match_parent"
    android:layout_height="720dp"
    android:layout_gravity="bottom"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="false"
        android:focusable="false">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp">

            <ImageButton
                android:id="@+id/back_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:backgroundTint="@android:color/transparent"
                android:background="@android:color/transparent"
                android:src="@drawable/arrow_left"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add your details"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/sand"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Selected Avatar Display -->
        <FrameLayout
            android:layout_width="175dp"
            android:layout_height="175dp"
            android:background="@drawable/avatar_strokeoval"
            android:layout_gravity="center"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:layout_marginBottom="40dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/detailAvatarBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:shapeAppearanceOverlay="@style/CircleImageView" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/detailAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:scaleType="centerInside"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:shapeAppearanceOverlay="@style/CircleImageView" />
        </FrameLayout>

        <!-- Form Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <!-- Username Field -->
            <EditText
                android:id="@+id/username_input"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Username"
                android:fontFamily="@font/poppins"
                android:textColor="@color/sand"
                android:textColorHint="@color/sand"
                android:textSize="18sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/input"
                android:layout_marginBottom="20dp"
                android:inputType="text"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="true" />

            <!-- Password Field -->
            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Password"
                android:fontFamily="@font/poppins"
                android:textColor="@color/sand"
                android:textColorHint="@color/sand"
                android:textSize="18sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/input"
                android:layout_marginBottom="20dp"
                android:inputType="textPassword"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="true" />

            <!-- Email Field -->
            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Email address"
                android:fontFamily="@font/poppins"
                android:textColor="@color/sand"
                android:textColorHint="@color/sand"
                android:textSize="18sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/input"
                android:layout_marginBottom="20dp"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="true" />

            <!-- Voice Type Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voice Type:"
                    android:textSize="18sp"
                    android:textColor="@color/sand"
                    android:fontFamily="@font/poppins" />

                <Spinner
                    android:id="@+id/genderSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_unselected"
                    android:paddingStart="10sp"/>
            </LinearLayout>

        <!-- Create Account Button -->
        <Button
            android:id="@+id/createaccount_button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="CREATE ACCOUNT"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/btn_selected"
            android:clickable="true"
            android:focusable="true"
            android:enabled="true" />
    </LinearLayout>
    </LinearLayout>
</ScrollView>