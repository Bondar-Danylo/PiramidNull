<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/light_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp">

            <ImageButton
                android:id="@+id/back_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:backgroundTint="@android:color/transparent"
                android:src="@drawable/arrow_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Avatar"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/sand"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Avatar Preview -->
        <FrameLayout
            android:layout_width="175dp"
            android:layout_height="175dp"
            android:background="@drawable/avatar_strokeoval"
            android:layout_gravity="center"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:layout_marginBottom="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatarBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:scaleType="centerCrop"
                android:alignmentMode="alignMargins"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:shapeAppearanceOverlay="@style/CircleImageView" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:scaleType="centerInside"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:shapeAppearanceOverlay="@style/CircleImageView"/>

        </FrameLayout>

        <!-- Step Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_character"
                android:layout_width="180dp"
                android:layout_height="50dp"
                android:background="@drawable/btn_selected"
                android:backgroundTint="@null"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins"
                android:text="1. Character"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="10dp"/>

            <Button
                android:id="@+id/btn_background"
                android:layout_width="180dp"
                android:layout_height="50dp"
                android:fontFamily="@font/poppins"
                android:background="@drawable/btn_unselected"
                android:backgroundTint="@null"
                android:textColor="@color/sand"
                android:text="2. Background"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="10dp"/>

        </LinearLayout>

        <!-- Character Selection Step -->
        <LinearLayout
            android:id="@+id/avatarStepLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">

            <GridLayout
                android:id="@+id/avatarGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

        <!-- Background Selection Step -->
        <LinearLayout
            android:id="@+id/backgroundStepLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Your Background"
                android:fontFamily="@font/poppins"
                android:textColor="@color/sand"
                android:textSize="16sp"
                android:layout_marginBottom="15dp"
                android:gravity="center" />

            <GridLayout
                android:id="@+id/backgroundGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:layout_marginBottom="20dp" />

            <!-- Save Changes Button - Only visible in background step -->
            <Button
                android:id="@+id/btn_save_changes"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/btn_selected"
                android:fontFamily="@font/poppins_semibold"
                android:text="Save Changes"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center" />

        </LinearLayout>

        <!-- Bottom Navigation Controls -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btns_bottom"
            android:layout_marginTop="15dp">

            <!-- Previous Button -->
            <ImageButton
                android:id="@+id/btn_previous"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/arrowleft_stroke"
                android:src="@drawable/arrow_left"
                android:visibility="gone"
                android:contentDescription="Previous"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Next Button -->
            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/arrow_strokeoval"
                android:src="@drawable/arrow_right"
                android:contentDescription="Next"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>