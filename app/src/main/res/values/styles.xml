<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Objects">
        <item name="android:background">@drawable/bg_box_sand</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="Underlined">
        <item name="android:fontFamily">@font/handwritten</item>
        <item name="android:background">@drawable/underline</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/sand</item>
        <item name="android:paddingBottom">7dp</item>
    </style>
    
    <style name="LongDescriptions">
        <item name="android:background">@drawable/textbox</item>
        <item name="android:padding">5dp</item>
        <item name="paddingStart">10dp</item>
        <item name="fontFamily">@font/handwritten</item>
        <item name="android:textSize">20dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/sand</item>
    </style>
    
    <style name="CategoryTitle">
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/sandT</item>
        <item name="android:layout_marginRight">15dp</item>
    </style>

</resources>